# Template for .env. deploy/install.sh creates .env from it on the server (root:<slug>, mode 640).
# .env is gitignored and must never be committed. Only connection details and secrets
# live here; everything else is a site setting in the database.

# Site name slug: /opt/<slug>, the app user and the files the installer writes. Set once by
# deploy/install.sh; never change it on a running site.
APP_SLUG=
NODE_ENV=production
# web | ingest | all
ROLE=all
HOST=127.0.0.1
PORT=3000
APP_URL=https://your.domain
AUTO_MIGRATE=true

# openssl rand -hex 32 for each. Never rotate SETTINGS_KEY once anything is encrypted.
SESSION_SECRET=
SETTINGS_KEY=

# PostgreSQL on RDS
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=true
# RDS CA bundle from https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
DB_SSL_CA=/opt/<slug>/certs/rds-global-bundle.pem

# Fallback from addresses; the mail driver is set in Admin > Site settings > Email.
# Amazon SES needs no keys here: it uses the EC2 instance role (ses:SendEmail on the verified identity).
SUPPORT_FROM_ADDRESS=
RESET_FROM_ADDRESS=

# First site settings, used once on an empty database; change them later in Admin > Site settings.
# Both in single quotes: dotenv reads an unquoted # as the start of a comment.
# SEED_THEME_PRIMARY is '#RRGGBB'.
SEED_SITE_NAME=
SEED_THEME_PRIMARY=

# First superadmin, created once on an empty database, forced to change password at first login
SEED_SUPERADMIN_USERNAME=
SEED_SUPERADMIN_EMAIL=
# Optional one time password (never commit it). Blank = a random one printed once by `npm run seed`.
SEED_SUPERADMIN_PASSWORD=
