<?xml version="1.0" encoding="UTF-8"?>
<!-- iisnode front door for devmon. Node runs inside IIS via iisnode; index.js requires app.js.
     Keep ONE process: the app runs realtime, MQTT ingest and jobs in this process (ROLE=all). -->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="index.js" verb="*" modules="iisnode" />
    </handlers>
    <iisnode
      nodeProcessCountPerApplication="1"
      devErrorsEnabled="true"
      loggingEnabled="true"
      logDirectory="iisnode"
      watchedFiles="web.config;*.js;routes\*.js;services\*.js;config\*.js"
      promoteServerVars="HTTPS,REMOTE_ADDR"
      maxNamedPipeConnectionRetry="100"
      namedPipeConnectionRetryDelay="250" />
    <rewrite>
      <rules>
        <rule name="Force HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions><add input="{HTTPS}" pattern="off" ignoreCase="true" /></conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="iisnode logs" stopProcessing="true">
          <match url="^iisnode(/.*)?$" />
          <action type="None" />
        </rule>
        <rule name="Everything to Node" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="index.js" />
        </rule>
      </rules>
    </rewrite>
    <!-- Deliberately no <httpErrors existingResponse="PassThrough" />. The customer's server admin
         does not permit it on the live WebApp servers, so IIS stays on its default
         existingResponse="Auto" and replaces the body of any 4xx or 5xx with its own text. The app
         compensates: middleware/httpStatus.js sends every reply as 200 and puts the real code in the
         x-app-status header. Do not add the element back without also setting ENABLED to false in that
         middleware. See DECISIONS.md. -->
    <!-- iisnode handles websocket upgrades itself; the IIS module must be off for socket.io. -->
    <webSocket enabled="false" />
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="10485760" />
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".env" />
          <add segment="storage" />
          <add segment="deploy" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <httpProtocol><customHeaders><remove name="X-Powered-By" /></customHeaders></httpProtocol>
  </system.webServer>
</configuration>
