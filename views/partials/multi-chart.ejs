<% /* multi-chart(elId, dataUrl, range): ECharts with one y axis per unit. Raw readings arrive in
      chunks newest first; older chunks load in the background, one series at a time (routes/charts.js).
      The view lives in the URL (iot-chart-tools.js); one chart per page owns it. */ %>
<div id="<%= elId %>" style="height: 440px"></div>
<div class="d-flex align-items-center gap-2 mt-2" id="<%= elId %>Foot" data-csrf="<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>" data-email-url="<%= dataUrl.replace(/\/data$/, "/email") %>" data-chart-vars="<%= JSON.stringify({ site_name: siteName, account_name: account ? account.name : "" }) %>"><div class="form-text m-0 d-none" id="<%= elId %>Note"></div></div>
<script>
document.addEventListener("DOMContentLoaded", function ()
{
    var el = document.getElementById("<%= elId %>");
    var panel = el.closest(".iot-panel");
    var chart = echarts.init(el);
    var css = getComputedStyle(document.documentElement);
    function v(n) { return css.getPropertyValue(n).trim(); }
    var palette = [v("--iot-primary"), v("--iot-success"), v("--iot-warning"), v("--iot-danger"), v("--iot-info"), "#a78bfa", "#f472b6", "#fb923c"];
    var MAX_POINTS = 100000;   // per series; past this the note says how far back that series goes
    var current = null;        // { from, to, series } as loaded so far
    var loadId = 0;
    var note = document.getElementById("<%= elId %>Note");
    function showNote(text)
    {
        note.textContent = text || "";
        note.classList.toggle("d-none", !text);
    }

    // The view from the URL: from and to (a shared link, Custom with a To) fix the window; from alone
    // (Custom without a To, Load 30 more days) runs from then up to now; start and end zoom the first draw.
    var view = iotChartTools.urlState();
    var fixed = view.from !== null && view.to !== null && view.to > view.from ? { from: view.from, to: view.to } : null;
    var since = view.from !== null && view.to === null ? view.from : null;
    var firstZoom = { start: view.start, end: view.end };
    var buttons = Array.from(panel.querySelectorAll("[data-range]"));
    var range = buttons.some(function (b) { return b.dataset.range === view.range; }) ? view.range : "<%= range %>";
    buttons.forEach(function (b) { b.classList.toggle("active", !fixed && since === null && b.dataset.range === range); });

    // keepZoom: redraw with the user's zoom window where it is (older chunks arriving);
    // initial: the zoom to start with, as percentages, when not keeping.
    function draw(keepZoom, initial)
    {
        var d = current;
        var zoom = initial || { start: 0, end: 100 };
        if (keepZoom)
        {
            var z = (chart.getOption().dataZoom || [])[1];
            if (z) { zoom = { start: z.start, end: z.end }; }
        }
        var units = []; d.series.forEach(function (s) { if (units.indexOf(s.unit) < 0) { units.push(s.unit); } });
        chart.setOption({
            animation: false, color: palette,
            grid: { left: 56, right: 24 + 44 * Math.max(0, units.length - 1), top: 40, bottom: 84 },
            legend: { top: 0, textStyle: { color: v("--iot-text-muted") } },
            tooltip: { trigger: "axis" },
            xAxis: { type: "time", min: d.from, max: d.to, axisLabel: { color: v("--iot-text-muted") }, axisLine: { lineStyle: { color: v("--iot-border") } } },
            yAxis: units.map(function (u, i) { return { type: "value", scale: true, name: u, position: i === 0 ? "left" : "right", offset: i > 1 ? (i - 1) * 44 : 0, axisLabel: { color: v("--iot-text-muted") }, splitLine: { show: i === 0, lineStyle: { color: v("--iot-border") } } }; }),
            // zoom window: slider with a preview of the first series, drag inside to pan, pinch or ctrl + wheel to zoom
            dataZoom: [
                { type: "inside", xAxisIndex: 0, zoomOnMouseWheel: "ctrl", start: zoom.start, end: zoom.end },
                { type: "slider", xAxisIndex: 0, start: zoom.start, end: zoom.end, height: 28, bottom: 8, borderColor: v("--iot-border"), textStyle: { color: v("--iot-text-muted") }, dataBackground: { lineStyle: { color: v("--iot-primary"), opacity: 0.5 }, areaStyle: { color: v("--iot-primary"), opacity: 0.1 } }, selectedDataBackground: { lineStyle: { color: v("--iot-primary") }, areaStyle: { color: v("--iot-primary"), opacity: 0.25 } } }
            ],
            series: d.series.map(function (s) { return { name: s.name, type: "line", showSymbol: false, sampling: "minmax", yAxisIndex: units.indexOf(s.unit), data: s.points, lineStyle: { width: 2 }, tooltip: { valueFormatter: function (x) { return Number(x).toFixed(s.precision) + " " + s.unit; } } }; })
        }, true);
    }

    // Newest chunk of every series draws at once; then each series that has more loads its older
    // chunks, added on the left. Clicking another range starts a new load and this one stops.
    async function load(range)
    {
        var id = ++loadId;
        showNote("");
        if (more) { more.disabled = true; }
        var res = await fetch("<%= dataUrl %>?" + (fixed ? "from=" + fixed.from + "&to=" + fixed.to : since !== null ? "from=" + since : "range=" + range));
        if (!res.ok) { showNote("Could not load readings."); return; }
        var d = await res.json();
        if (id !== loadId) { return; }
        current = d;
        draw(false, iotChartTools.zoomPct(current.from, current.to, firstZoom.start, firstZoom.end));
        firstZoom = { start: null, end: null };
        var cut = [];   // series that stopped at MAX_POINTS
        for (var i = 0; i < current.series.length; i++)
        {
            var s = current.series[i];
            var left = s.more, nextTo = s.next_to;
            while (left && s.points.length < MAX_POINTS)
            {
                showNote("Loading older readings for " + s.name + "...");
                res = await fetch("<%= dataUrl %>?range=" + range + "&from=" + Math.floor(current.from / 1000) + "&to=" + nextTo + "&sensor=" + encodeURIComponent(s.uid));
                if (!res.ok) { showNote("Could not load older readings."); return; }
                d = await res.json();
                if (id !== loadId) { return; }
                var older = d.series[0];
                if (!older) { left = false; break; }
                s.points = older.points.concat(s.points);
                left = older.more;
                nextTo = older.next_to;
                draw(true);
            }
            s.complete = !left;
            if (left) { cut.push(s.name + " (back to " + new Date(s.points[0][0]).toLocaleString() + ")"); }
        }
        if (cut.length) { showNote("Older readings in this range are not loaded for: " + cut.join("; ") + "."); }
        else { showNote(fixed ? "Fixed window: " + iotChartTools.localTime(current.from) + " to " + iotChartTools.localTime(current.to) + ". Click a range for the latest readings." : ""); }
        moreState();
    }

    // Load 30 more days: the 30 days before the oldest shown (at most a year in all), each series
    // fetched newest first in chunks and added on the left; the zoom window stays on the same times.
    var more = null;   // the Load 30 more days button
    function fullest() { return current ? Math.max.apply(null, current.series.map(function (s) { return s.points.length; }).concat([0])) : 0; }
    function moreState()
    {
        if (!more) { return; }
        var full = fullest() >= MAX_POINTS;
        var can = current && !full && iotChartTools.moreFrom(current.from, current.to) !== null;
        more.disabled = !can;
        more.title = can ? "Load the 30 days before the oldest day shown" : full ? "The chart holds as many readings as it can (" + MAX_POINTS.toLocaleString() + " per series)." : "A chart window is at most a year.";
    }
    async function loadMore()
    {
        if (!current) { return; }
        var newFrom = iotChartTools.moreFrom(current.from, current.to);
        if (newFrom === null || fullest() >= MAX_POINTS) { return; }
        var id = ++loadId;
        var keep = iotChartTools.isZoomed(chart) ? iotChartTools.visibleWindow(chart, current.from, current.to) : null;
        var zoomTo = function () { return keep ? iotChartTools.zoomPct(current.from, current.to, keep[0] / 1000, keep[1] / 1000) : null; };
        var oldFrom = Math.floor(current.from / 1000), fromSec = Math.ceil(newFrom / 1000);
        var added = 0, cut = [];
        more.disabled = true;
        current.from = fromSec * 1000;
        draw(false, zoomTo());
        for (var i = 0; i < current.series.length; i++)
        {
            var s = current.series[i];
            var left = true, to = oldFrom - 1;
            while (left && s.points.length < MAX_POINTS)
            {
                showNote("Loading older readings for " + s.name + "...");
                var res = await fetch("<%= dataUrl %>?from=" + fromSec + "&to=" + to + "&sensor=" + encodeURIComponent(s.uid));
                if (!res.ok) { showNote("Could not load older readings."); moreState(); return; }
                var d = await res.json();
                if (id !== loadId) { return; }
                var older = d.series[0];
                if (!older) { left = false; break; }
                s.points = older.points.concat(s.points);
                added += older.points.length;
                left = older.more;
                to = older.next_to;
                draw(false, zoomTo());
            }
            s.complete = s.complete && !left;
            if (left) { cut.push(s.name + " (back to " + iotChartTools.localTime(s.points[0][0]) + ")"); }
        }
        if (fixed) { fixed.from = fromSec; iotChartTools.setUrl({ from: fromSec }); }
        else
        {
            since = fromSec;
            iotChartTools.setUrl({ range: null, from: fromSec, to: null });
            buttons.forEach(function (x) { x.classList.remove("active"); });
            custom.classList.add("active");
        }
        if (cut.length) { showNote("Older readings in this range are not loaded for: " + cut.join("; ") + "."); }
        else if (!added) { showNote("No readings from " + iotChartTools.localTime(fromSec * 1000) + " to " + iotChartTools.localTime(oldFrom * 1000) + "."); }
        else { showNote(""); }
        moreState();
    }

    // Custom: From and To in the browser's timezone; To blank runs up to now, live.
    function applyCustom(fromSec, toSec)
    {
        buttons.forEach(function (x) { x.classList.remove("active"); });
        custom.classList.add("active");
        firstZoom = { start: null, end: null };
        if (toSec === null) { fixed = null; since = fromSec; }
        else { fixed = { from: fromSec, to: toSec }; since = null; }
        iotChartTools.setUrl({ range: null, from: fromSec, to: toSec, start: null, end: null });
        load(range);
    }
    buttons.forEach(function (b)
    {
        b.addEventListener("click", function ()
        {
            buttons.forEach(function (x) { x.classList.remove("active"); });
            b.classList.add("active");
            custom.classList.remove("active");
            fixed = null;
            since = null;
            firstZoom = { start: null, end: null };
            range = b.dataset.range;
            iotChartTools.setUrl({ range: range, from: null, to: null, start: null, end: null });
            load(range);
        });
    });
    window.addEventListener("resize", function () { chart.resize(); });
    // Download: the raw readings inside the zoom window, one row per reading with its series, in the
    // browser's timezone (the x axis uses it too; a saved chart can mix locations).
    var foot = document.getElementById("<%= elId %>Foot");
    var dataInView = function ()
    {
        if (!current) { return null; }
        var w = iotChartTools.visibleWindow(chart, current.from, current.to);
        var rows = [], short = [];
        current.series.forEach(function (s)
        {
            s.points.forEach(function (p) { if (p[0] >= w[0] && p[0] <= w[1]) { rows.push([s.name, iotChartTools.localTime(p[0]), Math.round(p[0] / 1000), p[1], s.unit]); } });
            var oldest = s.points.length ? s.points[0][0] : current.to;
            if (!s.complete && w[0] < oldest) { short.push(s.name + " (from " + iotChartTools.localTime(oldest) + ")"); }
        });
        var tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
        return { headers: ["Series", "Time (" + tz + ")", "Epoch", "Value", "Unit"], rows: rows, from: w[0], to: w[1], partial: short.length ? "Older readings are not loaded for: " + short.join("; ") + ". The file starts where each one does." : null };
    };
    iotChartTools.addDownload(foot, dataInView);
    // Share: email it (image and data attached), a link to this exact view, or a PNG of it; the zoom
    // window follows the URL as it changes. Location, device and sensor names are the series' own,
    // joined when they differ; chart_name is the panel title.
    function namesOf(key) { var u = []; (current ? current.series : []).forEach(function (s) { if (s[key] && u.indexOf(s[key]) < 0) { u.push(s[key]); } }); return u.join(", "); }
    iotChartTools.addShare(foot, { chart: chart, getSpan: function () { return current; }, getTimezone: null, getData: dataInView, nameTemplate: "{chart_name}, {window}", emailUrl: foot.dataset.emailUrl, csrf: foot.dataset.csrf, siteName: JSON.parse(foot.dataset.chartVars).site_name, getVars: function ()
    {
        var head = panel.querySelector(".iot-panel__header strong");
        return Object.assign(JSON.parse(foot.dataset.chartVars), { chart_name: head ? head.textContent.trim() : "", location_name: namesOf("location_name"), device_name: namesOf("device_name"), sensor_name: namesOf("sensor_name") });
    } });
    iotChartTools.trackZoom(chart, function () { return current; });
    var custom = iotChartTools.addCustomRange({ group: buttons[0].parentNode, getTimezone: null, getSpan: function () { return current; }, isLive: function () { return !fixed; }, onApply: applyCustom });
    custom.classList.toggle("active", !!fixed || since !== null);
    more = iotChartTools.addLoadMore(foot, loadMore);
    load(range);
});
</script>
