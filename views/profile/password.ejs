<div class="row">
  <div class="col-12 col-lg-6">
    <div class="iot-panel">
      <div class="iot-panel__header"><strong><%= confined ? "Set a new password to continue" : "Change password" %></strong></div>
      <div class="iot-panel__body">
        <form method="post" action="/profile/password" id="passwordForm" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <% if (!confined) { %>
          <label class="form-label" for="current">Current password</label>
          <input class="form-control mb-1<%= errors.current ? " is-invalid" : "" %>" id="current" name="current" type="password" autocomplete="current-password">
          <div class="invalid-feedback mb-2"><%= errors.current %></div>
          <% } %>

          <label class="form-label" for="password">New password</label>
          <input class="form-control mb-1<%= errors.password ? " is-invalid" : "" %>" id="password" name="password" type="password" autocomplete="new-password" autofocus>
          <div class="invalid-feedback mb-2"><%= errors.password %></div>
          <div class="form-text mb-3"><%= policy %></div>

          <label class="form-label" for="password2">Repeat new password</label>
          <input class="form-control mb-1<%= errors.password2 ? " is-invalid" : "" %>" id="password2" name="password2" type="password" autocomplete="new-password">
          <div class="invalid-feedback mb-4"><%= errors.password2 %></div>

          <button class="btn btn-primary" type="submit">Save password</button>
        </form>
        <% if (confined) { %>
        <form method="post" action="/logout" class="mt-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-link px-0" type="submit">Sign out instead</button></form>
        <% } %>
      </div>
    </div>
  </div>
</div>

<script>
// Catches the obvious mistakes before a round trip; the server still checks the policy.
document.addEventListener("DOMContentLoaded", function ()
{
    var form = document.getElementById("passwordForm");
    function mark(input, message)
    {
        input.classList.toggle("is-invalid", !!message);
        input.nextElementSibling.textContent = message || "";
    }
    form.addEventListener("submit", function (e)
    {
        var current = form.querySelector("#current");
        var password = form.querySelector("#password");
        var password2 = form.querySelector("#password2");
        var bad = null;
        if (current) { mark(current, current.value ? null : "Enter your current password."); bad = bad || (current.value ? null : current); }
        mark(password, password.value ? null : "Enter a new password.");
        bad = bad || (password.value ? null : password);
        var mismatch = !password2.value ? "Repeat the new password." : (password2.value !== password.value ? "Passwords do not match." : null);
        mark(password2, mismatch);
        bad = bad || (mismatch ? password2 : null);
        if (bad)
        {
            e.preventDefault();
            bad.focus();
        }
    });
});
</script>
