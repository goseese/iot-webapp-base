<%
// Profile > Support: the user's own support requests (routes/profile.js).
var statusClass = { open: "warning", answered: "online", closed: "offline" };
var statusLabel = { open: "Waiting on support", answered: "Answered", closed: "Closed" };
var sevClass = { "production-down": "text-bg-danger", "urgent": "text-bg-warning", "issue": "text-bg-secondary", "feature-request": "text-bg-info" };
var sevShort = { "production-down": "Production down", "urgent": "Urgent", "issue": "Issue", "feature-request": "Request" };
%>
<div class="iot-panel">
  <div class="iot-panel__header d-flex justify-content-between align-items-center"><strong>Your support requests</strong><button type="button" class="btn btn-sm btn-primary" data-support-open>New support request</button></div>
  <div class="table-responsive"><table class="table iot-table align-middle mb-0"><thead><tr><th>Reference</th><th>Updated</th><th>Status</th><th>Severity</th><th>Request</th></tr></thead><tbody>
  <% rows.forEach(function (r) { %>
    <tr>
      <td class="text-nowrap"><a href="/support/<%= fmt.uid(r.uid) %>"><%= r.ref %></a></td>
      <td class="text-nowrap"><span class="iot-hint" title="<%= fmt.epoch(r.updated_epoch, "UTC") %> UTC"><%= fmt.ago(r.updated_epoch) %></span></td>
      <td class="text-nowrap"><span class="iot-status iot-status--<%= statusClass[r.status] %>"><%= statusLabel[r.status] %></span></td>
      <td><span class="badge <%= sevClass[r.severity] %>"><%= sevShort[r.severity] %></span></td>
      <td class="small" style="max-width: 32rem; overflow-wrap: anywhere;"><%= r.summary %><%= r.summary && r.summary.length >= 140 ? "..." : "" %></td>
    </tr>
  <% }); %>
  <% if (!rows.length) { %><tr><td colspan="5" class="text-secondary">No support requests yet. Use Support request in the menu, on the page the problem is on, so support can see it.</td></tr><% } %>
  </tbody></table></div>
</div>
