<form class="d-flex gap-2 align-items-center mb-3" method="get">
  <select class="form-select form-select-sm" name="kind" style="max-width: 160px" onchange="this.form.submit()"><option value="">all kinds</option><% ["alarm", "invite", "reset", "report", "test", "system"].forEach(function (k) { %><option value="<%= k %>" <%= q.kind === k ? "selected" : "" %>><%= k %></option><% }); %></select>
  <select class="form-select form-select-sm" name="outcome" style="max-width: 160px" onchange="this.form.submit()"><option value="">all outcomes</option><% ["sent", "failed", "suppressed"].forEach(function (k) { %><option value="<%= k %>" <%= q.outcome === k ? "selected" : "" %>><%= k %></option><% }); %></select>
  <span class="text-secondary small">Every send decision for alarms, invitations, resets, reports and tests. Click a row for the full message and the provider's answer.</span>
</form>
<div class="iot-panel">
  <div class="table-responsive">
    <table class="table iot-table align-middle mb-0" id="notifTable">
      <thead><tr><th>When</th><th>Kind</th><th>Event</th><th>Sensor</th><th>To</th><th>Channel</th><th>Driver</th><th>Ladder</th><th>Outcome</th><th>Reason</th></tr></thead>
      <tbody>
      <% rows.forEach(function (n) { %>
        <tr <%- n.canOpen ? 'data-notification="' + Number(n.id) + '" role="button"' : "" %>>
          <td class="text-nowrap"><%= fmt.epoch(n.epoch, n.iana_timezone) %></td>
          <td><%= n.kind %></td>
          <td><%= n.event_kind || "" %></td>
          <td><% if (n.alarm_uid) { %><a href="/alarms/<%= fmt.uid(n.alarm_uid) %>"><%= n.sensor_name %></a> <span class="text-secondary small"><%= n.device_name %></span><% } %></td>
          <td><%= n.address %></td>
          <td><%= n.channel %></td>
          <td class="small"><%= n.provider || "" %></td>
          <td class="small text-secondary"><%= n.ladder_note || "" %></td>
          <td><span class="iot-status iot-status--<%= n.outcome === "sent" ? "online" : (n.outcome === "failed" ? "alarm" : "offline") %>"><%= n.outcome %></span></td>
          <td class="small text-secondary"><%= n.reason || "" %></td>
        </tr>
      <% }); %>
      <% if (!rows.length) { %><tr><td colspan="10" class="text-secondary">Nothing yet.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include("../partials/notification-modal") %>
<% if (rows.length > 20) { %><script>document.addEventListener("DOMContentLoaded", function () { document.querySelector("#notifTable")._devmonDataTable = new simpleDatatables.DataTable("#notifTable", { perPage: 25 }); });</script><% } %>
