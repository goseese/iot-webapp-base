<%
// One support request (routes/support.js GET /support/:uid). staff: the viewer is support for it;
// asStaff: support on someone else's request (replies count as support); superadmin: sees the
// server request id, whether email went out and the Sent to panel (the site's support addresses
// stay out of customers' view).
var statusClass = { open: "warning", answered: "online", closed: "offline" };
var statusLabel = { open: "Waiting on support", answered: "Answered", closed: "Closed" };
var sevClass = { "production-down": "text-bg-danger", "urgent": "text-bg-warning", "issue": "text-bg-secondary", "feature-request": "text-bg-info" };
var sevLabel = {};
supportForm.severities.forEach(function (s) { sevLabel[s.key] = s.label; });
var base = "/support/" + fmt.uid(request.uid);
var requesterName = request.display_name ? request.display_name + " (" + request.username + ")" : request.username;
var replyNumber = {};
messages.forEach(function (m, i) { replyNumber[m.id] = i + 1; });
function size(b) { return b >= 1048576 ? (b / 1048576).toFixed(1) + " MB" : Math.max(1, Math.round(b / 1024)) + " KB"; }
var images = files.filter(function (f) { return ["image/jpeg", "image/png", "image/gif", "image/webp"].indexOf(f.content_type) >= 0; });
var others = files.filter(function (f) { return images.indexOf(f) < 0; });
%>
<div class="row g-3">
  <div class="col-12 col-xl-8">
    <div class="iot-panel mb-3">
      <div class="iot-panel__header d-flex justify-content-between align-items-center">
        <strong><%= requesterName %></strong>
        <span class="small text-secondary sup-time" data-epoch="<%= request.created_epoch %>"><%= fmt.ago(request.created_epoch) %></span>
      </div>
      <div class="iot-panel__body">
        <div style="white-space: pre-wrap; overflow-wrap: anywhere;"><%= request.description %></div>
        <% if (images.length) { %>
        <div class="d-flex flex-wrap gap-2 mt-3">
          <% images.forEach(function (f) { %>
          <a href="<%= base %>/files/<%= f.id %>" target="_blank" rel="noopener" title="<%= f.filename %>, <%= size(f.size_bytes) %>"><img src="<%= base %>/files/<%= f.id %>" alt="<%= f.filename %>" style="max-height: 220px; max-width: 100%; border: 1px solid var(--iot-border); border-radius: var(--iot-radius);"></a>
          <% }); %>
        </div>
        <% } %>
        <% if (others.length) { %>
        <div class="mt-3 small">
          <% others.forEach(function (f) { %>
          <div><i class="fa-solid fa-paperclip me-1 text-secondary"></i><a href="<%= base %>/files/<%= f.id %>"><%= f.filename %></a> <span class="text-secondary"><%= size(f.size_bytes) %></span></div>
          <% }); %>
        </div>
        <% } %>
      </div>
    </div>

    <% messages.forEach(function (m) { %>
    <div class="iot-panel mb-3"<% if (m.is_staff) { %> style="border-left: 3px solid var(--iot-primary);"<% } %>>
      <div class="iot-panel__header d-flex justify-content-between align-items-center">
        <% if (m.is_staff) { %>
        <span><span class="badge text-bg-success">Support</span><% if (staff) { %> <strong class="ms-1"><%= m.display_name || m.username %></strong><% } %></span>
        <% } else { %>
        <strong><%= m.display_name ? m.display_name + " (" + m.username + ")" : m.username %></strong>
        <% } %>
        <span class="small text-secondary sup-time" data-epoch="<%= m.created_epoch %>"><%= fmt.ago(m.created_epoch) %></span>
      </div>
      <div class="iot-panel__body" style="white-space: pre-wrap; overflow-wrap: anywhere;"><%= m.body %></div>
    </div>
    <% }); %>

    <div class="iot-panel">
      <div class="iot-panel__header"><strong><%= asStaff ? "Reply to the requester" : "Reply to support" %></strong></div>
      <div class="iot-panel__body">
        <form method="post" action="<%= base %>/reply">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <textarea class="form-control mb-2" name="body" rows="5" maxlength="<%= max %>" required></textarea>
          <div class="d-flex justify-content-between align-items-center gap-2">
            <span class="small text-secondary">
              <% if (asStaff) { %>The requester gets an email with your reply and a link back to this page. Everyone else who handles this request is emailed too.<% } else { %>Support is notified by email.<% if (request.status === "closed") { %> Replying reopens this request.<% } %><% } %>
            </span>
            <button class="btn btn-primary text-nowrap">Send reply</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="col-12 col-xl-4">
    <div class="iot-panel mb-3">
      <div class="iot-panel__header"><strong>Request <%= request.ref %></strong></div>
      <div class="iot-panel__body small">
        <table class="table table-sm mb-0 iot-table" data-tools="none"><tbody>
          <tr><td class="text-secondary text-nowrap">Status</td><td><span class="iot-status iot-status--<%= statusClass[request.status] %>"><%= statusLabel[request.status] %></span></td></tr>
          <tr><td class="text-secondary text-nowrap">Severity</td><td><span class="badge <%= sevClass[request.severity] %>"><%= sevLabel[request.severity] %></span></td></tr>
          <tr><td class="text-secondary text-nowrap">Account</td><td><%= request.account_name || "Not specified" %></td></tr>
          <tr><td class="text-secondary text-nowrap">Location</td><td><%= request.location_name || "Not specified" %></td></tr>
          <tr><td class="text-secondary text-nowrap">Sent</td><td><span class="sup-time" data-epoch="<%= request.created_epoch %>"><%= fmt.epoch(request.created_epoch, "UTC") %> UTC</span></td></tr>
          <tr><td class="text-secondary text-nowrap">Last update</td><td><span class="sup-time" data-epoch="<%= request.updated_epoch %>"><%= fmt.epoch(request.updated_epoch, "UTC") %> UTC</span></td></tr>
          <% if (request.closed_epoch) { %><tr><td class="text-secondary text-nowrap">Closed</td><td><span class="sup-time" data-epoch="<%= request.closed_epoch %>"><%= fmt.epoch(request.closed_epoch, "UTC") %> UTC</span></td></tr><% } %>
          <tr><td class="text-secondary text-nowrap">Page</td><td style="overflow-wrap: anywhere;"><% if (request.page_url) { %><a href="<%= request.page_url %>"><%= request.page_title || request.page_url %></a><% } else { %>Not specified<% } %></td></tr>
          <% if (staff) { %>
          <tr><td class="text-secondary text-nowrap">From</td><td style="overflow-wrap: anywhere;"><%= requesterName %><br><a href="mailto:<%= request.email %>"><%= request.email %></a></td></tr>
          <tr><td class="text-secondary text-nowrap">Browser</td><td style="overflow-wrap: anywhere;"><%= request.user_agent || "Not specified" %><% if (request.viewport) { %><br><span class="text-secondary">viewport <%= request.viewport %></span><% } %></td></tr>
          <% } %>
          <% if (superadmin) { %>
          <tr><td class="text-secondary text-nowrap">Server request</td><td><% if (request.request_id) { %><a href="/admin/logs?cid=<%= request.request_id %>&amp;range=30d"><code><%= request.request_id %></code></a><% } else { %>Not specified<% } %></td></tr>
          <tr><td class="text-secondary text-nowrap">Emailed</td><td><%= request.email_sent ? "yes" : "no" %></td></tr>
          <% } %>
        </tbody></table>
        <% if (staff) { %>
        <form method="post" action="<%= base %>/status" class="mt-3">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% if (request.status === "closed") { %>
          <button class="btn btn-sm btn-outline-secondary" name="action" value="reopen">Reopen for support</button>
          <% } else { %>
          <button class="btn btn-sm btn-outline-secondary" name="action" value="close">Close request</button>
          <% } %>
        </form>
        <% } %>
      </div>
    </div>

    <% if (recipients) { %>
    <div class="iot-panel">
      <div class="iot-panel__header"><strong>Sent to</strong> <span class="text-secondary small ms-1">superadmins only</span></div>
      <div class="table-responsive"><table class="table iot-table table-sm align-middle mb-0 small" data-tools="none"><thead><tr><th>Email</th><th>Address</th><th>Result</th><th>When</th></tr></thead><tbody>
        <% recipients.forEach(function (x) { %>
        <tr>
          <td><%= x.support_message_id ? "Reply " + (replyNumber[x.support_message_id] || "") : "Request" %><br><span class="text-secondary"><%= x.audience %></span></td>
          <td style="overflow-wrap: anywhere;"><%= x.address %></td>
          <td><span class="iot-status iot-status--<%= x.outcome === "sent" ? "online" : "alarm" %>"><%= x.outcome %></span></td>
          <td class="text-nowrap"><span class="iot-hint" title="<%= fmt.epoch(x.created_epoch, "UTC") %> UTC"><%= fmt.ago(x.created_epoch) %></span></td>
        </tr>
        <% }); %>
        <% if (!recipients.length) { %><tr><td colspan="4" class="text-secondary">No email went out for this request.</td></tr><% } %>
      </tbody></table></div>
    </div>
    <% } %>
  </div>
</div>
<script>
document.addEventListener("DOMContentLoaded", function ()
{
    // Browser local times.
    document.querySelectorAll(".sup-time").forEach(function (el)
    {
        el.title = el.textContent;
        el.textContent = new Date(Number(el.dataset.epoch) * 1000).toLocaleString(undefined, { month: "short", day: "numeric", year: "numeric", hour: "numeric", minute: "2-digit" });
    });
});
</script>
