<div class="row g-3">
  <div class="col-12 col-xl-7">
    <div class="iot-panel">
      <div class="iot-panel__header"><strong>Ask for help</strong></div>
      <div class="iot-panel__body">
        <p class="text-secondary small">Describe what you need and the <%= siteName %> team will answer here. You will get an email when they reply; the conversation itself stays on this site.</p>
        <% if (error) { %><div class="alert alert-danger py-2"><%= error %></div><% } %>
        <form method="post" action="/help">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="mb-3">
            <label class="form-label" for="subject">Subject</label>
            <input class="form-control" id="subject" name="subject" maxlength="<%= max.subject %>" value="<%= values.subject || "" %>" required>
          </div>
          <% if (accounts.length > 1) { %>
          <div class="mb-3">
            <label class="form-label" for="account_id">Account</label>
            <select class="form-select" id="account_id" name="account_id">
              <option value="">Not about a specific account</option>
              <% accounts.forEach(function (a) { %><option value="<%= a.id %>" <%= String(values.account_id || "") === String(a.id) ? "selected" : "" %>><%= a.name %></option><% }); %>
            </select>
          </div>
          <% } %>
          <div class="mb-3">
            <label class="form-label" for="body">Message</label>
            <textarea class="form-control" id="body" name="body" rows="8" maxlength="<%= max.body %>" required><%= values.body || "" %></textarea>
          </div>
          <button class="btn btn-primary">Send request</button>
        </form>
      </div>
    </div>
  </div>
  <div class="col-12 col-xl-5">
    <div class="iot-panel">
      <div class="iot-panel__header"><strong>Your requests</strong></div>
      <%- include("../partials/support-requests", { mine: mine }) %>
    </div>
  </div>
</div>
