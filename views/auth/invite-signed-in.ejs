<div class="text-center mb-3"><i class="fa-solid fa-user-check fa-2x text-primary"></i></div>
<h1 class="h4 text-center mb-2"><%= title %></h1>
<p class="text-secondary text-center">You are signed in as <strong><%= username %></strong>. This invitation is for <strong><%= invite.email %></strong>.</p>
<p class="text-secondary text-center mb-4">Sign out to accept it. The invitation stays open until it is accepted.</p>
<form method="post" action="/invite/<%= invite.token %>/sign-out">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <button class="btn btn-primary w-100" type="submit">Sign out and continue</button>
</form>
<a class="btn btn-outline-secondary w-100 mt-2" href="/dashboard">Go to the dashboard</a>
