<%
function field(s)
{
%>
  <% if (s.fromEnv) { %><span class="text-secondary"><%= s.kind === "secret" ? "********" : s.shown %></span> <span class="badge text-bg-secondary">.env</span><% } else { %>
  <form method="post" action="/admin/settings/<%= s.key %>" class="d-flex gap-1">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% if (s.kind === "bool") { %>
      <div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" name="value" value="1" <%= s.value ? "checked" : "" %> onchange="this.form.submit()"></div>
    <% } else { %>
      <input class="form-control form-control-sm" name="value" type="<%= s.kind === "secret" ? "password" : (s.kind === "int" ? "number" : "text") %>" value="<%= s.shown === null || s.shown === undefined ? "" : s.shown %>" <%= s.kind === "int" && s.min !== null ? 'min="' + s.min + '"' : "" %> <%= s.kind === "int" && s.max !== null ? 'max="' + s.max + '"' : "" %> placeholder="<%= s.kind === "secret" ? "not set" : "" %>" autocomplete="off">
      <button class="btn btn-sm btn-outline-secondary">Save</button>
    <% } %>
  </form>
  <% } %>
<%
}
function row(s)
{
%>
  <tr>
    <td><code><%= s.key %></code><% if (s.needsRestart) { %> <span class="badge text-bg-warning">restart</span><% } %></td>
    <td><% field(s); %></td>
    <td class="small text-secondary"><%= s.description %><% if (s.kind === "int" && s.min !== null) { %> (<%= s.min %> to <%= s.max %>)<% } %></td>
  </tr>
<%
}
%>

<% if (group === "email") { %>
<div class="iot-panel mb-3">
  <div class="iot-panel__header d-flex justify-content-between align-items-center">
    <span><strong>Mail provider</strong> <span class="text-secondary small ms-2">sending via <strong><%= mailActive %></strong><%= mailActive !== mailChosen ? " because " + mailChosen + " is not configured" : "" %>, from <%= mailFrom %></span></span>
    <form method="post" action="/admin/settings/email/test"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline-secondary" type="submit">Send test email to me</button></form>
  </div>
  <div class="iot-panel__body">
    <% var md = byKey.MAIL_DRIVER; %>
    <div class="row g-3 align-items-end">
      <div class="col-md-5">
        <label class="form-label">Driver</label>
        <% if (md.fromEnv) { %><div class="form-control-plaintext"><%= mailChosen %> <span class="badge text-bg-secondary">.env</span></div><% } else { %>
        <form method="post" action="/admin/settings/MAIL_DRIVER" class="d-flex gap-1">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <select class="form-select form-select-sm" name="value"><% mailDrivers.forEach(function (d) { %><option value="<%= d.name %>" <%= d.name === mailChosen ? "selected" : "" %>><%= d.label %><%= d.configured ? "" : " (not configured)" %></option><% }); %></select>
          <button class="btn btn-sm btn-outline-secondary">Save</button>
        </form>
        <% } %>
      </div>
      <div class="col-md-7 small text-secondary">Set the driver, save, then fill in that driver's credentials below and send yourself a test. Results, including failures with the provider's reason, are on the alarm notifications log.</div>
    </div>
  </div>
  <div class="table-responsive"><table class="table iot-table align-middle mb-0"><thead><tr><th style="width: 26%">Setting</th><th style="width: 30%">Value</th><th>Description</th></tr></thead><tbody>
    <% ["MAIL_FROM_ADDRESS", "MAIL_FROM_NAME"].forEach(function (k) { if (byKey[k]) { row(byKey[k]); } }); %>
  </tbody></table></div>
</div>
<% mailDrivers.filter(function (d) { return d.keys.length; }).forEach(function (d) { %>
<div class="iot-panel mb-3 <%= d.name === mailChosen ? "" : "opacity-75" %>">
  <div class="iot-panel__header"><strong><%= d.label %></strong> <span class="iot-status iot-status--<%= d.configured ? "online" : "offline" %> ms-2"><%= d.configured ? "configured" : "not configured" %></span></div>
  <div class="table-responsive"><table class="table iot-table align-middle mb-0"><tbody>
    <% d.keys.forEach(function (k) { if (byKey[k]) { row(byKey[k]); } }); %>
  </tbody></table></div>
</div>
<% }); %>
<% } %>

<% if (group === "sms") { %>
<div class="iot-panel mb-3">
  <div class="iot-panel__header"><strong>SMS provider</strong></div>
  <div class="iot-panel__body">
    <% var sd = byKey.SMS_DRIVER; %>
    <div class="col-md-5">
      <label class="form-label">Driver</label>
      <% if (sd.fromEnv) { %><div class="form-control-plaintext"><%= smsChosen %> <span class="badge text-bg-secondary">.env</span></div><% } else { %>
      <form method="post" action="/admin/settings/SMS_DRIVER" class="d-flex gap-1">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <select class="form-select form-select-sm" name="value"><% smsDrivers.forEach(function (d) { %><option value="<%= d.name %>" <%= d.name === smsChosen ? "selected" : "" %>><%= d.label %><%= d.configured ? "" : " (not configured)" %></option><% }); %></select>
        <button class="btn btn-sm btn-outline-secondary">Save</button>
      </form>
      <% } %>
    </div>
  </div>
</div>
<% smsDrivers.filter(function (d) { return d.keys.length; }).forEach(function (d) { %>
<div class="iot-panel mb-3 <%= d.name === smsChosen ? "" : "opacity-75" %>">
  <div class="iot-panel__header"><strong><%= d.label %></strong> <span class="iot-status iot-status--<%= d.configured ? "online" : "offline" %> ms-2"><%= d.configured ? "configured" : "not configured" %></span></div>
  <div class="table-responsive"><table class="table iot-table align-middle mb-0"><tbody>
    <% d.keys.forEach(function (k) { if (byKey[k]) { row(byKey[k]); } }); %>
  </tbody></table></div>
</div>
<% }); %>
<% } %>

<% if (rows.length) { %>
<div class="iot-panel">
  <div class="table-responsive"><table class="table iot-table align-middle mb-0"><thead><tr><th style="width: 26%">Setting</th><th style="width: 30%">Value</th><th>Description</th></tr></thead><tbody>
  <% rows.forEach(function (s) { row(s); }); %>
  </tbody></table></div>
</div>
<% } %>
<p class="text-secondary small mt-3">Values set in <code>.env</code> are shown read only and override the database.</p>
