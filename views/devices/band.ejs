<%# The band last presented to a pod (services/athletes.js current()), for a controller's Station tab
    (mode "checkin": who is checked in at this station) and an account pod's page (mode "enroll":
    whose band this is, or a form to enroll it). Rendered again by the live refresh; data-pid lets
    the page keep a name being typed unless a different band has been presented. %>
<% var b = band; var cur = b.current; var uid = fmt.uid(device.uid); var checkin = b.mode === "checkin";
   var otherAccount = cur && cur.band && cur.band.account_id !== b.accountId;
   var noAthlete = cur && (cur.outcome === "unknown" || cur.outcome === "unassigned" || cur.outcome === "expired"); %>
<div class="iot-panel mb-3" data-pid="<%= cur ? cur.presentation.id : 0 %>">
  <div class="iot-panel__header d-flex align-items-center gap-2">
    <strong><%= checkin ? "Checked in" : "Wristband" %></strong>
    <% if (cur) { %><span class="text-secondary small">band <%= fmt.hardwareId(cur.presentation.band_mac) %>, <span data-epoch="<%= cur.presentation.epoch %>"><%= fmt.ago(cur.presentation.epoch, now) %></span></span><% } %>
    <% if (cur && b.canCheckout) { %>
    <form method="post" action="/devices/<%= uid %>/checkout" class="ms-auto">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-sm btn-outline-secondary" type="submit"><%= checkin ? "Check out" : "Clear" %></button>
    </form>
    <% } %>
  </div>
  <div class="iot-panel__body">
  <% if (!cur) { %>
    <div class="text-secondary"><%= checkin ? "Nobody is checked in. Present a wristband to the controller." : "Present a wristband to this pod to enroll it or see whose it is." %></div>
  <% } else if (cur.outcome === "checked_in") { %>
    <div class="fs-3 fw-bold"><% if (b.athleteUrl) { %><a href="<%= b.athleteUrl %>"><%= cur.athlete.display_name %></a><% } else { %><%= cur.athlete.display_name %><% } %></div>
    <div class="small text-secondary"><code><%= cur.athlete.slug %></code><%= cur.assignment && cur.assignment.expires_epoch ? ", loaner until " + fmt.epoch(cur.assignment.expires_epoch, location.iana_timezone) : "" %><%= otherAccount ? ", from another account" : "" %></div>
    <% if (!checkin && b.canRename) { %>
    <form method="post" action="<%= b.athleteUrl %>/rename" class="d-flex gap-2 mt-3" style="max-width: 28rem">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="back" value="/devices/<%= uid %>">
      <input class="form-control" name="name" value="<%= cur.athlete.display_name %>" required maxlength="80" aria-label="Display name">
      <button class="btn btn-outline-primary" type="submit">Save name</button>
    </form>
    <% } %>
  <% } else if (cur.outcome === "lost" || cur.outcome === "retired") { %>
    <div class="alert alert-danger mb-0">This band is marked <strong><%= cur.outcome %></strong><%= cur.athlete ? " (last with " + cur.athlete.display_name + ")" : "" %>. Mark it found on the account's Wristbands page to use it again.</div>
  <% } else if (otherAccount) { %>
    <div class="alert alert-warning mb-0">This band belongs to another account<%= cur.outcome === "expired" ? " and its loan has run out" : "" %>, so it cannot be <%= checkin ? "checked in" : "enrolled" %> here.</div>
  <% } else if (checkin) { %>
    <div class="alert alert-warning mb-0">
      <% if (cur.outcome === "expired") { %><strong>Loan expired.</strong> This band was lent to <%= cur.athlete ? cur.athlete.display_name : "an athlete" %> and the loan has run out.
      <% } else if (cur.outcome === "unassigned") { %><strong>No athlete.</strong> This band is registered but nobody has it.
      <% } else { %><strong>Unknown band.</strong> Enroll it at an account pod first.<% } %>
    </div>
  <% } else if (noAthlete) { %>
    <div class="alert alert-warning py-3 mb-3"><div class="fs-4 fw-bold">NO ATHLETE</div><%= cur.outcome === "expired" ? "This band's loan to " + (cur.athlete ? cur.athlete.display_name : "an athlete") + " has run out." : (cur.outcome === "unassigned" ? "This band is registered but nobody has it." : "This band is new.") %> Type the athlete's name to enroll it.</div>
    <% if (b.canEnroll) { %>
    <form method="post" action="/devices/<%= uid %>/enroll" class="d-flex gap-2" style="max-width: 28rem">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="band" value="<%= cur.presentation.band_mac %>">
      <input class="form-control" name="name" required maxlength="80" placeholder="Athlete name" aria-label="Athlete name" autocomplete="off">
      <button class="btn btn-primary text-nowrap" type="submit">Enroll band</button>
    </form>
    <% } else { %><div class="small text-secondary">Enrolling needs the Manage athletes permission.</div><% } %>
  <% } %>
  </div>
</div>
