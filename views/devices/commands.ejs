<% var uid = fmt.uid(device.uid); var queued = !!queue; var ready = queued ? !queue.error : (cred && cred.state === "active"); %>

<% if (queued) { %>
<p class="text-secondary small">Commands are queued and sent one at a time: each waits for the pod's answer before the next goes out. A command for a pod that is offline goes out when it next connects. Cancel removes a command that has not been answered yet.<% if (queue.pod && queue.pod.id !== device.id) { %> This pod's commands go through its controller, <a href="/devices/<%= fmt.uid(queue.pod.uid) %>"><%= queue.pod.name %></a>.<% } %></p>
<% if (queue.error) { %><div class="alert alert-secondary"><%= queue.error %></div><% } %>
<% } else { %>
<p class="text-secondary small">Commands go to the gateway right away and are not queued. If the gateway is offline nothing happens, and nothing is sent when it reconnects.</p>
<% if (!ready) { %><div class="alert alert-secondary">This unit has no active broker credentials yet, so commands cannot be sent.</div><% } %>
<% } %>
<div class="iot-panel mb-3">
  <div class="iot-panel__header"><strong>Commands</strong></div>
  <div class="iot-panel__body">
    <% commands.forEach(function (c, i) { %>
    <form method="post" action="/devices/<%= uid %>/commands" class="d-flex align-items-center gap-3<%= i < commands.length - 1 ? " mb-3" : "" %>"<% if (c.confirm) { %> onsubmit="return confirmCommand(event)" data-label="<%= c.label %>" data-confirm="<%= c.description %>"<% } %>>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="command" value="<%= c.name %>">
      <button class="btn btn-outline-primary text-nowrap" style="min-width: 8rem" type="submit" <%= ready ? "" : "disabled" %>><%= c.label %></button>
      <% if (c.value === "color") { %>
      <select class="form-select form-select-sm w-auto" name="value" aria-label="Color" <%= ready ? "" : "disabled" %>>
        <% colors.forEach(function (col) { %><option value="<%= col[0] %>"><%= col[1] %></option><% }); %>
      </select>
      <% } %>
      <div class="form-text m-0"><%= c.description %></div>
    </form>
    <% }); %>
  </div>
</div>

<% if (queued) { %>
<div id="command-list" data-device="<%= uid %>" data-owner="<%= queue.ownerUid || "" %>">
<%- include("command-list") %>
</div>
<% } %>

<script>
async function confirmCommand(e) { e.preventDefault(); var f = e.target; if (await iotConfirm({ title: f.getAttribute("data-label") + "?", body: f.getAttribute("data-confirm"), confirmText: "<%= queued ? "Queue it" : "Send to gateway" %>", danger: true })) { f.submit(); } return false; }

// Live queue: a "config" notice for the pod that sends these commands (this pod, or a target pod's
// controller) means its queue changed; fetch the list once, debounced, and swap its parts.
document.addEventListener("DOMContentLoaded", function ()
{
    var box = document.getElementById("command-list");
    if (!box || !window.iotSocket) { return; }
    var device = box.getAttribute("data-device");
    var owner = box.getAttribute("data-owner");
    var timer = null;

    async function refresh()
    {
        timer = null;
        try
        {
            var res = await fetch("/devices/" + device + "/commands/list", { credentials: "same-origin", headers: { "Accept": "text/html" } });
            if (!res.ok) { return; }
            var next = document.createElement("div");
            next.innerHTML = await res.text();
            var parts = next.querySelectorAll("[data-part]");
            if (parts.length === 0) { return; }      // not the list (e.g. the session expired and this is the login page)
            parts.forEach(function (p)
            {
                var old = box.querySelector('[data-part="' + p.getAttribute("data-part") + '"]');
                if (old && old.innerHTML !== p.innerHTML) { old.innerHTML = p.innerHTML; }
            });
        }
        catch (err) { }
    }

    window.iotSocket.on("config", function (msg)
    {
        if (!msg || (msg.device !== owner && msg.device !== device)) { return; }
        if (timer) { clearTimeout(timer); }
        timer = setTimeout(refresh, 500);
    });
    window.iotSocket.on("ready", function () { if (!timer) { timer = setTimeout(refresh, 1000); } });
});
</script>
