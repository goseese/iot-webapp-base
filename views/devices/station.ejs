<%# Pod station panel (services/stations.js), rendered on a controller's Sensors tab and by
    GET /devices/:uid/station, which the page fetches when a config notice arrives over the socket.
    station.pairing.on is what the controller reported; station.wanted is what the page asked for.
    The refresh swaps each data-part element's content, so the table tools (iot-table-tools.js)
    added to the panel header when the page loaded stay in place. %>
<% var st = station; var uid = fmt.uid(device.uid); %>
<div data-part="banner">
<% if (st.pairing.on || st.wanted) { %>
<div class="alert alert-primary py-3 mb-3" role="status">
  <div class="fs-3 fw-bold"><%= st.pairing.on && st.wanted ? "PAIRING MODE" : (st.wanted ? "PAIRING MODE, STARTING" : "PAIRING MODE, STOPPING") %></div>
  <% if (st.pairing.on && st.wanted) { %>
  <div>Hold the button on a target pod until it appears in the list below, then pair the next one. Pairing stays on until it is turned off here.</div>
  <% } else if (st.wanted) { %>
  <div>Waiting for the controller to confirm. If it is offline, it gets this when it next connects.</div>
  <% } else { %>
  <div>Waiting for the controller to confirm that pairing is off. Until it does, a target pod whose button is held can still pair with it.</div>
  <% } %>
</div>
<% } %>
</div>
<div class="iot-panel mb-3">
  <div class="iot-panel__header d-flex align-items-center gap-2">
    <span><strong>Station</strong> <span class="text-secondary small ms-2" data-part="count"><%= st.pods.length %> target pod<%= st.pods.length === 1 ? "" : "s" %></span></span>
    <span data-part="control" class="ms-auto iot-header-end"><% if (st.canPair) { %>
    <form method="post" action="/devices/<%= uid %>/pairing">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="action" value="<%= st.wanted ? "off" : "on" %>">
      <button class="btn btn-sm <%= st.wanted ? "btn-outline-primary" : "btn-primary" %>" type="submit" <%= !st.wanted && st.elsewhere ? "disabled" : "" %>><%= st.wanted ? "Stop pairing" : "Pair target pods" %></button>
    </form>
    <% } %></span>
  </div>
  <div data-part="all"><% if (st.canPair && st.pods.length) { %>
  <form method="post" action="/devices/<%= uid %>/commands" class="d-flex align-items-center gap-2 px-3 pt-3">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="command" value="led">
    <input type="hidden" name="to" value="all">
    <input type="hidden" name="from" value="station">
    <span class="small text-secondary">Every target pod's LEDs:</span>
    <select class="form-select form-select-sm w-auto" name="value" aria-label="Color">
      <% st.colors.forEach(function (col) { %><option value="<%= col[0] %>"><%= col[1] %></option><% }); %>
    </select>
    <button class="btn btn-sm btn-outline-primary" type="submit">Send</button>
    <a class="small ms-2" href="/devices/<%= uid %>/commands">Queue</a>
  </form>
  <% } %></div>
  <div data-part="note"><% if (st.elsewhere && !st.wanted) { %>
  <div class="px-3 pt-2 small text-secondary"><a href="/devices/<%= fmt.uid(st.elsewhere.uid) %>"><%= st.elsewhere.name %></a> at this location is in pairing mode. Only one controller per location can pair at a time.</div>
  <% } %></div>
  <div class="table-responsive">
    <table class="table iot-table align-middle mb-0">
      <thead><tr><th>Target pod</th><th>Type</th><th>Hardware id</th><th>Signal</th><th>Last heard</th></tr></thead>
      <tbody data-part="pods">
      <% st.pods.forEach(function (p) { %>
        <tr>
          <td><a href="/devices/<%= fmt.uid(p.uid) %>"><%= p.name %></a></td>
          <td class="small"><%= p.type_name %></td>
          <td class="small"><code><%= fmt.hardwareId(p.hardware_id) %></code></td>
          <td><% if (p.signal_pct !== null) { %><span title="<%= p.last_rssi %> dBm"><%= p.signal_pct %>%</span><% } %></td>
          <td class="text-secondary" data-live="device:<%= fmt.uid(p.uid) %>:ago" data-epoch="<%= p.last_seen_epoch || 0 %>"><%= fmt.ago(p.last_seen_epoch, now) %></td>
        </tr>
      <% }); %>
      <% if (!st.pods.length) { %><tr><td colspan="5" class="text-secondary">No target pods yet. Turn on pairing, then hold the button on each target pod.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
