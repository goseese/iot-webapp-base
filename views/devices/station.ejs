<%# Pod station panel (services/stations.js), rendered on a controller's Station tab and by
    GET /devices/:uid/station, which the page fetches when a config notice arrives over the socket.
    station.pairing.on is what the controller reported; station.wanted is what the page asked for.
    The refresh swaps each data-part element's content, so the table tools (iot-table-tools.js)
    added to the panel header when the page loaded stay in place. %>
<% var st = station; var uid = fmt.uid(device.uid); %>
<div data-part="checkin"><%- include("band", { band: st.checkin }) %></div>
<div data-part="banner">
<% if (st.pairing.on || st.wanted) { %>
<div class="alert alert-primary py-3 mb-3" role="status">
  <div class="fs-3 fw-bold"><%= st.pairing.on && st.wanted ? "PAIRING MODE" : (st.wanted ? "PAIRING MODE, STARTING" : "PAIRING MODE, STOPPING") %></div>
  <% if (st.pairing.on && st.wanted) { %>
  <div>Hold the button on a target pod until it appears in the list below, then pair the next one. Pairing stays on until it is turned off here.</div>
  <% } else if (st.wanted) { %>
  <div>Waiting for the controller to confirm. If it is offline, it gets this when it next connects.</div>
  <% } else { %>
  <div>Waiting for the controller to confirm that pairing is off. Until it does, a target pod whose button is held can still pair with it.</div>
  <% } %>
</div>
<% } %>
</div>
<div class="iot-panel mb-3">
  <div class="iot-panel__header d-flex align-items-center gap-2">
    <span><strong>Station</strong> <span class="text-secondary small ms-2" data-part="count"><%= st.pods.length %> target pod<%= st.pods.length === 1 ? "" : "s" %></span></span>
    <span data-part="control" class="ms-auto iot-header-end"><% if (st.canPair) { %>
    <form method="post" action="/devices/<%= uid %>/pairing">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="action" value="<%= st.wanted ? "off" : "on" %>">
      <button class="btn btn-sm <%= st.wanted ? "btn-outline-primary" : "btn-primary" %>" type="submit" <%= !st.wanted && st.elsewhere ? "disabled" : "" %>><%= st.wanted ? "Stop pairing" : "Pair target pods" %></button>
    </form>
    <% } %></span>
  </div>
  <% if (st.canPair && st.pods.length) { %>
  <%# The bulk action controls live in the table footer and post through this form: the tick
      boxes, the color select and both submit buttons carry form="otaForm". The footer stays
      hidden until at least one target pod is ticked (syncAll in show.ejs). %>
  <form id="otaForm" method="post" action="/devices/<%= uid %>/station/ota" onsubmit="return confirmOta(event)">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  </form>
  <% } %>
  <div data-part="note"><% if (st.buttonRefused && !st.pairing.on) { %>
  <div class="px-3 pt-2 small text-warning">The pairing button on this controller was pressed <span data-epoch="<%= st.buttonRefused.epoch %>"><%= fmt.ago(st.buttonRefused.epoch, now) %></span> and <%= st.buttonRefused.detail %>.</div>
  <% } %><% if (st.elsewhere && !st.wanted) { %>
  <div class="px-3 pt-2 small text-secondary"><a href="/devices/<%= fmt.uid(st.elsewhere.uid) %>"><%= st.elsewhere.name %></a> at this location is in pairing mode. Only one controller per location can pair at a time.</div>
  <% } %></div>
  <div class="table-responsive">
    <table class="table iot-table align-middle mb-0">
      <thead><tr><% if (st.canPair) { %><th data-export="skip" style="width: 2rem"><input class="form-check-input" type="checkbox" id="otaAll" aria-label="Tick every target pod"></th><% } %><th>Target pod</th><th>Type</th><th>Hardware id</th><th>Firmware</th><th>Signal</th><th>Last heard</th></tr></thead>
      <tbody data-part="pods">
      <% st.pods.forEach(function (p) { %>
        <tr>
          <% if (st.canPair) { %><td><input class="form-check-input ota-pick" type="checkbox" name="pod" value="<%= fmt.uid(p.uid) %>" form="otaForm" aria-label="Tick <%= p.name %>"></td><% } %>
          <td><a href="/devices/<%= fmt.uid(p.uid) %>"><%= p.name %></a></td>
          <td class="small"><%= p.type_name %></td>
          <td class="small"><code><%= fmt.hardwareId(p.hardware_id) %></code></td>
          <td class="small"><%= p.firmware || "" %><% if (p.ota) { %> <span class="iot-status iot-status--warning"><%= p.ota.status === "queued" ? "update queued" : (p.ota.pct !== null ? "updating " + p.ota.pct + "%" : "update sent") %></span><% } %></td>
          <td><% if (p.signal_pct !== null) { %><span title="<%= p.last_rssi %> dBm"><%= p.signal_pct %>%</span><% } %></td>
          <td class="text-secondary" data-live="device:<%= fmt.uid(p.uid) %>:ago" data-epoch="<%= p.last_seen_epoch || 0 %>"><%= fmt.ago(p.last_seen_epoch, now) %></td>
        </tr>
      <% }); %>
      <% if (!st.pods.length) { %><tr><td colspan="<%= st.canPair ? 7 : 6 %>" class="text-secondary">No target pods yet. Turn on pairing, then hold the button on each target pod.</td></tr><% } %>
      </tbody>
      <% if (st.canPair && st.pods.length) { %>
      <tfoot data-part="actions" id="stationActions" class="d-none">
        <tr>
          <td colspan="7">
            <div class="d-flex align-items-center gap-2">
              <span id="stationSel" class="small text-secondary me-2">0 selected</span>
              <label class="small text-secondary" for="ledColor">Turn LEDs</label>
              <select id="ledColor" class="form-select form-select-sm w-auto" name="value" form="otaForm" aria-label="Color">
                <% st.colors.forEach(function (col) { %><option value="<%= col[0] %>"><%= col[1] %></option><% }); %>
              </select>
              <button class="btn btn-sm btn-outline-primary" type="submit" form="otaForm" formaction="/devices/<%= uid %>/station/led">Send</button>
            </div>
          </td>
        </tr>
        <tr>
          <td colspan="7">
            <div class="d-flex align-items-center flex-wrap gap-2">
              <button id="otaGo" class="btn btn-sm btn-outline-primary" type="submit" form="otaForm" formaction="/devices/<%= uid %>/station/ota" <%= st.firmware ? "" : "disabled" %>>Update firmware</button>
              <span class="small text-secondary"><% if (st.firmware) { %>On the server: <%= st.firmware.image %>, <%= (st.firmware.bytes / 1048576).toFixed(2) %> MB, copied <span data-epoch="<%= st.firmware.mtime_epoch %>"><%= fmt.ago(st.firmware.mtime_epoch, now) %></span>, MD5 <code><%= st.firmware.md5.slice(0, 8) %></code><% } else { %><span class="text-warning">There is no firmware file on the server for these pods yet.</span><% } %></span>
            </div>
          </td>
        </tr>
      </tfoot>
      <% } %>
    </table>
  </div>
</div>
