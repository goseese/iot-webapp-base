<%# Account > Athletes (routes/account/athletes.js). %>
<% function bandText(b) { return (b.label || fmt.hardwareId(b.band_mac)) + (b.expires_epoch ? (b.expires_epoch <= now ? " (loan expired)" : " (loaner)") : ""); } %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <% if (canManage) { %><button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addAthlete"><i class="fa-solid fa-plus me-1"></i>Add athlete</button><% } else { %><span></span><% } %>
  <a class="small" href="<%= acctBase %>/wristbands">Wristbands</a>
</div>

<div class="iot-panel">
  <div class="table-responsive">
    <table class="table iot-table is-sortable align-middle mb-0">
      <thead><tr><th class="sort-alpha">Athlete</th><th class="sort-alpha">Id</th><th>Wristband</th><th class="sort-numeric">Last check in</th></tr></thead>
      <tbody>
      <% rows.forEach(function (a) { %>
        <tr>
          <td><a href="<%= acctBase %>/athletes/<%= fmt.uid(a.uid) %>"><%= a.display_name %></a></td>
          <td class="small"><code><%= a.slug %></code></td>
          <td class="small"><%= a.bands.length ? a.bands.map(bandText).join(", ") : "" %><% if (!a.bands.length) { %><span class="text-secondary">none</span><% } %></td>
          <td class="text-secondary small" data-sort="<%= a.last_seen || "" %>"><%= a.last_seen ? fmt.ago(a.last_seen, now) : "never" %></td>
        </tr>
      <% }); %>
      <% if (!rows.length) { %><tr><td colspan="4" class="text-secondary">No athletes yet. Add one here, or present a new wristband to an account pod.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<% if (canManage) { %>
<div class="modal fade" id="addAthlete" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <form method="post" action="<%= acctBase %>/athletes">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal-header"><h5 class="modal-title">Add athlete</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <label class="form-label" for="name">Name</label>
        <input class="form-control" id="name" name="name" required maxlength="80" autocomplete="off">
        <div class="form-text">Their id is made from the name, for example jordan-smith. Give them a wristband on their page.</div>
      </div>
      <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" type="submit">Add athlete</button></div>
    </form>
  </div></div>
</div>
<% } %>
