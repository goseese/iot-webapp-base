
<% if (newKey) { %>
<div class="alert alert-success"><strong>New API key, shown once:</strong> <code class="user-select-all"><%= newKey %></code><br><span class="small">Use it as <code>Authorization: Bearer &lt;key&gt;</code> against <code><%= apiBase %></code>.</span></div>
<% } %>

<div class="row g-3">
  <div class="col-12 col-xl-6">
    <div class="iot-panel mb-3">
      <div class="iot-panel__header"><strong>API credentials</strong> <a class="small ms-2" href="<%= acctBase %>/api/docs">How to use the API</a></div>
      <div class="table-responsive"><table class="table iot-table align-middle mb-0"><thead><tr><th>Name</th><th>Prefix</th><th>Permissions</th><th>Last used</th><th></th></tr></thead><tbody>
      <% creds.forEach(function (c) { %>
        <tr><td><%= c.name %></td><td class="font-monospace small"><%= c.key_prefix %>_...</td><td class="small"><%= c.names.join(", ") %></td><td class="small text-secondary"><%= fmt.ago(c.last_used_epoch, now) %><%= c.expires_epoch ? ", expires " + fmt.epoch(c.expires_epoch) : "" %></td>
          <td class="text-end"><% if (canManage) { %><form method="post" action="<%= acctBase %>/api"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="uid" value="<%= fmt.uid(c.uid) %>"><input type="hidden" name="name" value="x"><button class="btn btn-sm btn-outline-danger" name="action" value="revoke" onclick="return confirm('Revoke this key? Clients using it stop working immediately.')">Revoke</button></form><% } %></td></tr>
      <% }); %>
      <% if (!creds.length) { %><tr><td colspan="5" class="text-secondary">No credentials.</td></tr><% } %>
      </tbody></table></div>
      <% if (canManage) { %>
      <div class="iot-panel__body border-top">
        <% if (!keyPrefix) { %>
        <div class="alert alert-warning mb-0 small">API keys cannot be created until API_KEY_PREFIX is set in Admin &gt; Site settings &gt; API.</div>
        <% } else { %>
        <form method="post" action="<%= acctBase %>/api" class="row g-2 align-items-end">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="col-md-5"><label class="form-label small">Name</label><input class="form-control form-control-sm" name="name" required placeholder="Warehouse PLC"></div>
          <div class="col-md-3"><label class="form-label small">Expires (days)</label><input class="form-control form-control-sm" name="expires_days" placeholder="never"></div>
          <div class="col-12 d-flex flex-wrap gap-3">
            <% permissions.BITS.filter(function (p) { return ["view", "api_write", "ack_alarm", "clear_alarm"].indexOf(p.name) >= 0; }).forEach(function (p) { var allowed = permissions.has(ceiling, p.bit); %>
            <div class="form-check"><input class="form-check-input" type="checkbox" name="perms" value="<%= p.name %>" id="api_<%= p.name %>" <%= p.name === "view" && allowed ? "checked" : "" %> <%= allowed ? "" : "disabled" %>><label class="form-check-label small" for="api_<%= p.name %>"><%= p.label %></label></div>
            <% }); %>
          </div>
          <div class="col-12"><button class="btn btn-sm btn-primary">Create key</button></div>
        </form>
        <% } %>
      </div>
      <% } %>
    </div>
  </div>
</div>
