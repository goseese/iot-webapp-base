<% var canCreate = currentUser && currentUser.is_superadmin; %>
<% if (canCreate) { %><div class="d-flex justify-content-end mb-3"><button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#newAccount"><i class="fa-solid fa-plus me-1"></i>New account</button></div><% } %>
<% if (!accounts.length) { %>
<div class="iot-panel">
  <div class="iot-panel__header"><strong>No account yet</strong></div>
  <div class="iot-panel__body">You have not been added to an account. Ask an administrator for an invitation.</div>
</div>
<% } else { %>
<div class="iot-panel">
  <div class="table-responsive"><table class="table iot-table align-middle mb-0"><thead><tr><th>Account</th><th>Locations</th><th>Account pods</th><th>Controller pods</th><th>Target pods</th><th>Athletes</th><th>Status</th></tr></thead><tbody>
  <% accounts.forEach(function (a) { %>
    <tr class="<%= a.is_enabled ? "" : "text-secondary" %>">
      <td><a href="/account/<%= fmt.uid(a.uid) %>"><%= a.name %></a> <% if (a.notifications_muted) { %><i class="fa-solid fa-bell-slash text-secondary" title="Notifications muted"></i><% } %></td>
      <td><%= a.locations %></td>
      <td><%= a.pods.account %></td>
      <td><%= a.pods.controller %></td>
      <td><%= a.pods.target %></td>
      <td><% if (a.pods.athletes === null) { %><span class="text-secondary" title="Athletes are not tracked yet">-</span><% } else { %><%= a.pods.athletes %><% } %></td>
      <td><span class="iot-status iot-status--<%= a.is_enabled ? "online" : "offline" %>"><%= a.is_enabled ? "enabled" : "disabled" %></span></td>
    </tr>
  <% }); %>
  </tbody></table></div>
</div>
<% } %>
<% if (canCreate) { %>
<div class="modal fade" id="newAccount" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
  <form method="post" action="/admin/accounts"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="modal-header"><h5 class="modal-title">New account</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body"><label class="form-label">Name</label><input class="form-control" name="name" required maxlength="120"><div class="form-text">Creates the known tags and a Default alert group. Invite users from the account's Users tab.</div></div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary">Create</button></div>
  </form>
</div></div></div>
<% } %>
