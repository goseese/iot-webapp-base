
<div class="row g-3 mb-4">
  <%- include("../partials/stat", { label: "Locations", value: totals.locations }) %>
  <%- include("../partials/stat", { label: "Gateways", value: totals.gateways }) %>
  <%- include("../partials/stat", { label: "Devices", value: totals.devices, status: totals.offline ? { kind: "offline", label: totals.offline + " offline" } : null }) %>
  <%- include("../partials/stat", { label: "Active alarms", value: totals.alarms, status: totals.alarms ? { kind: "alarm", label: "Requires attention" } : { kind: "online", label: "All clear" } }) %>
</div>

<% if (account.notifications_muted) { %>
<div class="alert alert-warning d-flex justify-content-between align-items-center">
  <span><i class="fa-solid fa-bell-slash me-2"></i>Notifications for this account are muted. Alarms still record.</span>
  <% if (permissions.has(bits, permissions.byName.manage_alarms)) { %>
  <form method="post" action="<%= acctBase %>/mute"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="muted" value="0"><button class="btn btn-sm btn-warning">Turn notifications on</button></form>
  <% } %>
</div>
<% } %>

<div class="iot-panel">
  <div class="iot-panel__header d-flex align-items-center justify-content-between">
    <strong>Locations</strong>
    <div class="d-flex gap-2">
      <% if (!account.notifications_muted && permissions.has(bits, permissions.byName.manage_alarms)) { %>
      <form method="post" action="<%= acctBase %>/mute" onsubmit="return confirmMute(event)"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="muted" value="1"><button class="btn btn-sm btn-outline-secondary" type="submit"><i class="fa-solid fa-bell-slash me-1"></i>Mute account</button></form>
      <% } %>
      <a class="btn btn-sm btn-outline-secondary" href="<%= acctBase %>/locations">Manage</a>
    </div>
  </div>
  <div class="table-responsive">
    <table class="table iot-table align-middle mb-0">
      <thead><tr><th>Location</th><th>Gateways</th><th>Devices</th><th>Alarms</th><th>Timezone</th></tr></thead>
      <tbody>
      <% locations.forEach(function (l) { %>
        <tr>
          <td>
            <a href="/locations/<%= fmt.uid(l.uid) %>"><%= l.name %></a>
            <% var mm = l.membership_mode, mmIcon = { locked: "fa-lock", release: "fa-box-open", auto_claim: "fa-wand-magic-sparkles" }[mm] || "fa-lock-open", mmClass = { locked: "text-bg-secondary", release: "text-bg-info", auto_claim: "text-bg-warning" }[mm] || "text-bg-light", mmTitle = { locked: "Locked: no automatic joins", release: "Release: devices may be taken by any location with add permission", auto_claim: "Auto claim: beacons heard here are added automatically until it ends" }[mm] || "Normal membership"; %>
            <span class="badge <%= mmClass %> ms-1" title="<%= mmTitle %>"><i class="fa-solid <%= mmIcon %> me-1"></i><%= mm === "auto_claim" ? "auto claim" : mm %></span>
            <% var am = l.alarm_mode || (l.notifications_muted ? "muted" : "active"); %>
            <span class="badge <%= am === "active" ? "text-bg-success" : (am === "muted" ? "text-bg-warning" : "text-bg-danger") %>" title="<%= am === "active" ? "Alarms evaluated and notified" : (am === "muted" ? "Alarms recorded, nobody notified" : "Alarms not evaluated") %>"><i class="fa-solid <%= am === "active" ? "fa-bell" : (am === "muted" ? "fa-bell-slash" : "fa-power-off") %> me-1"></i><%= am %></span>
          </td>
          <td><%= l.counts.gateways %></td>
          <td><%= l.counts.devices %><% if (l.counts.offline) { %> <span class="text-secondary small">(<%= l.counts.offline %> offline)</span><% } %></td>
          <td><% if (l.counts.alarms) { %><span class="iot-status iot-status--alarm"><%= l.counts.alarms %></span><% } else { %><span class="text-secondary">0</span><% } %></td>
          <td class="text-secondary"><%= l.iana_timezone %></td>
        </tr>
      <% }); %>
      <% if (!locations.length) { %><tr><td colspan="5" class="text-secondary">No locations yet.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
<script>
async function confirmMute(e)
{
    e.preventDefault();
    if (await iotConfirm({ title: "Mute all notifications for <%= account.name %>?", body: "Alarms will still be recorded, but nobody will be emailed or texted until you turn notifications back on.", confirmText: "Mute", danger: true })) { e.target.submit(); }
    return false;
}
</script>
