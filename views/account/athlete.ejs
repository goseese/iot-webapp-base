<%# One athlete (routes/account/athletes.js): name, bands now and before, recent check ins. %>
<% var aUid = fmt.uid(athlete.uid); var here = acctBase + "/athletes/" + aUid;
   var open = detail.assignments.filter(function (x) { return !x.closed_epoch; });
   function loanText(x) { if (!x.expires_epoch) { return "Permanent"; } return x.expires_epoch <= now ? "Loan expired " + fmt.ago(x.expires_epoch, now) : "Loaner until " + fmt.epoch(x.expires_epoch, tz); } %>
<div class="row g-3">
  <div class="col-12 col-xl-5">
    <div class="iot-panel mb-3">
      <div class="iot-panel__header"><strong>Athlete</strong> <span class="text-secondary small ms-2"><code><%= athlete.slug %></code></span></div>
      <div class="iot-panel__body">
        <% if (canManage) { %>
        <form method="post" action="<%= here %>/rename" class="d-flex gap-2">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input class="form-control" name="name" value="<%= athlete.display_name %>" required maxlength="80" aria-label="Name">
          <button class="btn btn-outline-primary" type="submit">Save</button>
        </form>
        <div class="form-text">The id stays the same when the name changes.</div>
        <% } else { %><div class="fs-5"><%= athlete.display_name %></div><% } %>
        <div class="small text-secondary mt-2">Added <%= fmt.epoch(athlete.created_epoch, tz) %></div>
      </div>
    </div>

    <% if (canManage) { %>
    <div class="iot-panel mb-3">
      <div class="iot-panel__header"><strong>Give a wristband</strong></div>
      <div class="iot-panel__body">
        <% if (detail.freeBands.length) { %>
        <form method="post" action="<%= here %>/assign" class="d-flex flex-wrap gap-2 align-items-center">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <select class="form-select w-auto" name="band" aria-label="Band">
            <% detail.freeBands.forEach(function (b) { %><option value="<%= fmt.uid(b.uid) %>"><%= b.label ? b.label + " (" + fmt.hardwareId(b.band_mac) + ")" : fmt.hardwareId(b.band_mac) %></option><% }); %>
          </select>
          <select class="form-select w-auto" name="loan" aria-label="Loan">
            <% Object.keys(loans).forEach(function (k) { %><option value="<%= k %>"><%= loans[k] %></option><% }); %>
          </select>
          <button class="btn btn-primary" type="submit">Give</button>
        </form>
        <% } else { %><div class="text-secondary small">No free bands in this account. Add one on the <a href="<%= acctBase %>/wristbands">Wristbands</a> page, or present a new band to an account pod.</div><% } %>
      </div>
    </div>
    <% } %>
  </div>

  <div class="col-12 col-xl-7">
    <div class="iot-panel mb-3">
      <div class="iot-panel__header"><strong>Wristbands</strong> <span class="text-secondary small ms-2"><%= open.length %> now</span></div>
      <div class="table-responsive">
        <table class="table iot-table align-middle mb-0">
          <thead><tr><th>Band</th><th>Kind</th><th>From</th><th>Until</th><th data-export="skip"></th></tr></thead>
          <tbody>
          <% detail.assignments.forEach(function (x) { %>
            <tr class="<%= x.closed_epoch ? "text-secondary" : "" %>">
              <td><%= x.label || fmt.hardwareId(x.band_mac) %><% if (x.label) { %> <span class="small text-secondary"><%= fmt.hardwareId(x.band_mac) %></span><% } %></td>
              <td class="small"><%= loanText(x) %></td>
              <td class="small"><%= fmt.epoch(x.start_epoch, tz) %></td>
              <td class="small"><%= x.closed_epoch ? fmt.epoch(x.closed_epoch, tz) + " (" + x.closed_reason + ")" : "" %></td>
              <td class="text-end text-nowrap">
                <% if (canManage && !x.closed_epoch) { %>
                <form method="post" action="<%= acctBase %>/wristbands/<%= fmt.uid(x.band_uid) %>/status" class="d-inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="<%= here %>">
                  <button class="btn btn-sm btn-outline-secondary" name="status" value="returned" type="submit">Returned</button>
                  <button class="btn btn-sm btn-outline-danger" name="status" value="lost" type="submit">Lost</button>
                </form>
                <% } %>
              </td>
            </tr>
          <% }); %>
          <% if (!detail.assignments.length) { %><tr><td colspan="5" class="text-secondary">No wristband yet.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="iot-panel">
      <div class="iot-panel__header"><strong>Recent check ins</strong></div>
      <div class="table-responsive">
        <table class="table iot-table align-middle mb-0">
          <thead><tr><th>When</th><th>Pod</th><th>Location</th><th>Band</th></tr></thead>
          <tbody>
          <% detail.presentations.forEach(function (p) { %>
            <tr>
              <td class="small" title="<%= fmt.epoch(p.epoch, tz) %>"><%= fmt.ago(p.epoch, now) %></td>
              <td class="small"><a href="/devices/<%= fmt.uid(p.pod_uid) %>"><%= p.pod_name %></a></td>
              <td class="small"><%= p.location_name %></td>
              <td class="small"><%= fmt.hardwareId(p.band_mac) %><% if (p.outcome !== "checked_in") { %> <span class="text-warning"><%= p.outcome %></span><% } %></td>
            </tr>
          <% }); %>
          <% if (!detail.presentations.length) { %><tr><td colspan="4" class="text-secondary">None yet.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
