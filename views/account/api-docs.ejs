<%
// API documentation for this account (Account > API > API Docs). Every word and example comes from
// services/apiDocs.js, the same source as the Download docs file; edit it there, not here. This view
// only lays it out and picks the viewer's branch (key prefix not set, can or cannot create a key).
var s = docs.site, t = docs.t;
function h(str) { return apiDocs.html(str, acctBase); }
%>

<div class="row g-3">
  <div class="col-12 col-xl-3 order-xl-2">
    <div class="iot-panel">
      <div class="iot-panel__header"><strong>On this page</strong></div>
      <div class="iot-panel__body small">
        <a href="#keys">Getting a key</a><br>
        <a href="#requests">Making requests</a><br>
        <a href="#replies">Replies and errors</a><br>
        <a href="#permissions">Permissions</a><br>
        <% docs.endpoints.forEach(function (e) { %><a href="#<%= e.id %>" class="font-monospace"><%= e.method %> <%= e.path %></a><br><% }); %>
        <a href="<%= acctBase %>/webhooks/docs">Webhooks</a>
      </div>
    </div>
  </div>

  <div class="col-12 col-xl-9 order-xl-1">

    <div class="iot-panel mb-3" id="keys">
      <div class="iot-panel__header"><strong>Getting a key</strong></div>
      <div class="iot-panel__body">
        <p><%- h(t.keyIntro) %></p>
        <% if (!s.keyPrefix) { %>
        <div class="alert alert-warning small mb-0"><%- h(t.noPrefix) %></div>
        <% } else if (canManage) { %>
        <ol class="mb-2">
          <% t.keySteps.forEach(function (x) { %><li><%- h(x) %></li><% }); %>
        </ol>
        <p class="mb-0 small text-secondary"><%- h(t.keyAfter) %></p>
        <% } else { %>
        <p class="mb-0"><%- h(t.keyWho) %> You can read these docs; ask someone who manages this account's users to create a key for you, and tell them which permissions the program needs.</p>
        <% } %>
      </div>
    </div>

    <div class="iot-panel mb-3" id="requests">
      <div class="iot-panel__header"><strong>Making requests</strong></div>
      <div class="iot-panel__body">
        <p><%- h(t.requestIntro) %></p>
        <pre class="iot-pre"><%= t.authLine %></pre>
        <p><%- h(t.shellIntro) %></p>
        <pre class="iot-pre"><%= t.shell %></pre>
        <ul class="small mb-0">
          <% t.requestNotes.forEach(function (x) { %><li><%- h(x) %></li><% }); %>
        </ul>
      </div>
    </div>

    <div class="iot-panel mb-3" id="replies">
      <div class="iot-panel__header"><strong>Replies and errors</strong></div>
      <div class="iot-panel__body">
        <p><%- h(t.replyIntro) %></p>
        <pre class="iot-pre"><%= JSON.stringify(t.replySample, null, 2) %></pre>
        <div class="table-responsive"><table class="table iot-table table-sm small mb-0"><thead><tr><th>Status</th><th>Meaning</th></tr></thead><tbody>
          <% t.statuses.forEach(function (r) { %><tr><td><%= r[0] %></td><td><%- h(r[1]) %></td></tr><% }); %>
        </tbody></table></div>
      </div>
    </div>

    <div class="iot-panel mb-3" id="permissions">
      <div class="iot-panel__header"><strong>Permissions</strong></div>
      <div class="iot-panel__body">
        <p class="small"><%- h(t.permissionsIntro) %></p>
        <div class="table-responsive"><table class="table iot-table table-sm small mb-0"><thead><tr><th>Permission</th><th>Lets the key</th></tr></thead><tbody>
          <% docs.permissions.forEach(function (r) { %><tr><td><%= r[0] %></td><td><%- h(r[1]) %></td></tr><% }); %>
        </tbody></table></div>
      </div>
    </div>

    <% docs.endpoints.forEach(function (e) { %>
    <div class="iot-panel mb-3" id="<%= e.id %>">
      <div class="iot-panel__header"><strong class="font-monospace"><%= e.method %> <%= e.path %></strong> <span class="text-secondary small ms-2">needs <%= e.perm %></span></div>
      <div class="iot-panel__body">
        <p><%= e.about %></p>
        <% if (e.params.length) { %>
        <div class="table-responsive"><table class="table iot-table table-sm small mb-3"><thead><tr><th>Parameter</th><th></th></tr></thead><tbody>
          <% e.params.forEach(function (p) { %><tr><td class="font-monospace"><%= p[0] %></td><td><%= p[1] %></td></tr><% }); %>
        </tbody></table></div>
        <% } %>
        <div class="small text-secondary mb-1">Example</div>
        <pre class="iot-pre"><%= e.example %></pre>
        <div class="small text-secondary mb-1">Reply</div>
        <pre class="iot-pre"><%= JSON.stringify(e.response, null, 2) %></pre>
        <% if (e.note) { %><p class="small mb-0"><%= e.note %></p><% } %>
      </div>
    </div>
    <% }); %>

  </div>
</div>
