<%
// Webhook documentation for this account (Account > Webhooks > Webhook Docs). Every word and sample
// comes from services/apiDocs.js, the same source as the Download docs file; edit it there, not here.
// This view only lays it out and picks the viewer's branch (can or cannot add a webhook).
var t = docs.t;
function h(str) { return apiDocs.html(str, acctBase); }
%>

<div class="row g-3">
  <div class="col-12 col-xl-9">

    <div class="iot-panel mb-3" id="setup">
      <div class="iot-panel__header"><strong>Adding a webhook</strong></div>
      <div class="iot-panel__body">
        <p><%- h(t.hookIntro) %></p>
        <% if (canEdit) { %>
        <ol class="mb-2">
          <% t.hookSteps.forEach(function (x) { %><li><%- h(x) %></li><% }); %>
        </ol>
        <p class="mb-0 small text-secondary"><%- h(t.hookAfter) %></p>
        <% } else { %>
        <p class="mb-0"><%- h(t.hookWho) %> You can read these docs; ask someone who holds it to add one for you.</p>
        <% } %>
      </div>
    </div>

    <div class="iot-panel mb-3" id="delivery">
      <div class="iot-panel__header"><strong>Deliveries</strong></div>
      <div class="iot-panel__body">
        <p class="small"><%- h(t.headersIntro) %></p>
        <ul class="small">
          <% t.headers.forEach(function (x) { %><li><%- h(x) %></li><% }); %>
        </ul>
        <p class="small mb-0"><%- h(t.retries) %></p>
      </div>
    </div>

    <div class="iot-panel mb-3" id="events">
      <div class="iot-panel__header"><strong>Events</strong></div>
      <div class="iot-panel__body">
        <div class="small text-secondary mb-1">A reading event</div>
        <pre class="iot-pre"><%= JSON.stringify(t.readingSample, null, 2) %></pre>
        <p class="small"><%- h(t.readingText) %></p>
        <div class="small text-secondary mb-1">An alarm event</div>
        <pre class="iot-pre"><%= JSON.stringify(t.alarmSample, null, 2) %></pre>
        <p class="small mb-0"><%- h(t.alarmText) %> <%- h(t.alarmGap) %></p>
      </div>
    </div>

    <div class="iot-panel mb-3" id="signature">
      <div class="iot-panel__header"><strong>Checking the signature</strong></div>
      <div class="iot-panel__body">
        <p class="small"><%- h(t.signatureIntro) %></p>
        <pre class="iot-pre mb-0"><%= t.signatureCode %></pre>
      </div>
    </div>

  </div>
</div>
